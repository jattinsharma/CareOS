rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Vault documents are stored under vaults/{groupId}/...
    // Access is limited to authenticated members of that family group.
    match /vaults/{groupId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/familyGroups/$(groupId)).data.members;
    }
  }
}
